JWT_SECRET=SUBSTITUA_POR_SEGREDO_ALEATORIO_COM_PELO_MENOS_32_CARACTERES
CLIENT_0_USER=cliente@example.com
# Gere o hash com scripts/hash-password.js (senha pela entrada padrão).
CLIENT_0_PASS_HASH=
CLIENT_0_SCRIPT_URL=https://script.google.com/macros/s/SEU_SCRIPT_ID/exec
# Deve coincidir com API_SHARED_SECRET nas propriedades do Apps Script.
CLIENT_0_SCRIPT_KEY=
# CLIENT_0_PASS continua aceito apenas para migração. Remova após configurar PASS_HASH.
# Repita CLIENT_1_*, CLIENT_2_*, sem lacunas nos índices. Não reatribua índices a outros clientes.
